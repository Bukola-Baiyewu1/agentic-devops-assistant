# Copy to .env (never commit .env). Every value is optional for a local demo.

# ---- Planner -----------------------------------------------------------------
# Empty key = deterministic mock planner (free, offline). With a key = Claude.
ANTHROPIC_API_KEY=
# Exact model ID from https://docs.claude.com/en/docs/about-claude/models/overview
AGENT_MODEL=claude-sonnet-5-5
# auto | mock | anthropic
AEGIS_LLM_PROVIDER=auto
MAX_PLAN_ITERATIONS=4
# Estimated USD per million tokens, used only for the cost estimate in traces.
AEGIS_LLM_INPUT_PRICE_PER_MTOK=3.0
AEGIS_LLM_OUTPUT_PRICE_PER_MTOK=15.0

# ---- Approvers -----------------------------------------------------------------
# name:password pairs, comma separated. Prefer hashes: name:sha256:<hex>
#   python -c "import hashlib;print(hashlib.sha256(b'my-password').hexdigest())"
# Empty in development = one demo user, demo / demo. Required in production.
AEGIS_USERS=
# Signs approval challenges. Must be 32+ random characters in production:
#   python -c "import secrets;print(secrets.token_hex(32))"
AEGIS_SECRET_KEY=

# How long an approval window stays open, in seconds.
AEGIS_APPROVAL_TTL_SECONDS=900

# ---- Ingress -------------------------------------------------------------------
# If set, alerts must carry X-Aegis-Signature: sha256=<HMAC of the body>.
AEGIS_WEBHOOK_SECRET=
AEGIS_RATE_LIMIT_PER_MINUTE=120

# ---- Storage -------------------------------------------------------------------
# Local default is SQLite. Docker Compose sets PostgreSQL automatically.
# DATABASE_URL=postgresql+psycopg://aegis:password@localhost:5432/aegis

# ---- Observability ---------------------------------------------------------------
# Langfuse tracing is enabled when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# e.g. https://cloud.langfuse.com or https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
# If set, /metrics requires "Authorization: Bearer <token>".
AEGIS_METRICS_TOKEN=

# development | production (production refuses insecure settings)
AEGIS_ENV=development
