# Copy this file to .env and fill in your key.
# Leave ANTHROPIC_API_KEY blank to run in mock mode (no API calls, still works).
ANTHROPIC_API_KEY=

# Any Claude model you have access to (e.g. claude-sonnet-5, claude-haiku-4-5).
AGENT_MODEL=claude-sonnet-4-5

# Optional overrides
STATE_PATH=.aegis_state.json
RUNBOOKS_DIR=runbooks
MAX_PLAN_ITERATIONS=3
